cabal-version:      2.4
name:               cs2-marketplaces

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

synopsis: Servant bindings to CS2 marketplaces 

description: This package provides comprehensive and type-safe bindings
            to various CS2 marketplaces, as well as a unified interface.

license:            BSD-3-Clause

license-file:       LICENSE

author:             Justin Grubbs

maintainer:         justin.grubbs@outlook.com

build-type:         Simple

extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

source-repository head
    type:           git
    location:       https://github.com/justingrubbs/cs2-marketplaces

common warnings
    ghc-options: -Wall

common extensions
    default-extensions:
        DataKinds
        , DeriveAnyClass
        , DeriveGeneric
        , DerivingStrategies
        , DuplicateRecordFields
        , LambdaCase
        , OverloadedRecordDot
        , OverloadedStrings
        , RecordWildCards
        , ScopedTypeVariables
        , TypeApplications
        , TypeOperators

library
    import:           warnings, extensions
    exposed-modules:  
                    CS2.Marketplaces.CSFloat
                    , CS2.Marketplaces.CSFloat.API
                    , CS2.Marketplaces.CSFloat.Error
                    , CS2.Marketplaces.CSFloat.RateLimit
                    , CS2.Marketplaces.CSFloat.Types
                    , CS2.RateLimit
                    , CS2.Steam.Types
    -- other-modules:
    -- other-extensions:
    build-depends:    
                    base ^>=4.20.2.0
                    , aeson
                    , bytestring
                    , brotli
                    , containers
                    , cryptonite
                    , http-client
                    , http-client-tls
                    , http-types
                    , random
                    , servant
                    , servant-client
                    , servant-client-core
                    , stm
                    , text
                    , time
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite unit
    import:            warnings, extensions
    default-language:  Haskell2010
    type:              exitcode-stdio-1.0
    hs-source-dirs:    test/unit
    main-is:           Spec.hs
    other-modules:
                    CS2.RateLimitSpec
                    , CS2.Marketplaces.CSFloat.ErrorSpec
                    , CS2.Marketplaces.CSFloat.RateLimitSpec
                    , CS2.Marketplaces.CSFloat.TypesSpec
                    , CS2.Steam.TypesSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
                    base ^>=4.20.2.0
                    , cs2-marketplaces
                    , QuickCheck
                    , aeson
                    , bytestring
                    , containers
                    , hspec
                    , servant
                    , servant-client-core
                    , stm
                    , text
                    , time

common repl-deps
    build-depends:
        base ^>=4.20.2.0
        , cs2-marketplaces
        , dotenv
        , text
        , pretty-simple
        , containers

        , http-client
        , http-client-tls
        , bytestring
        , aeson

executable csfloat
    import:         warnings, extensions, repl-deps
    main-is:        CSFloat.hs
    hs-source-dirs: app
    default-language: Haskell2010
